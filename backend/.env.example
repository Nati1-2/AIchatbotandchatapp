ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5432/relay
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3000
SECURE_COOKIES=false
SESSION_DAYS=14
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=replace-with-private-storage-access-key
S3_SECRET_KEY=replace-with-private-storage-secret
S3_BUCKET=relay-private
MAX_UPLOAD_BYTES=10485760
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=50
AI_TIMEOUT_SECONDS=60
AI_CONTEXT_CHARS=24000
